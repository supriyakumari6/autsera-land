# ── Optional for local use. Copy to .env only if you want to change something. ──
# With NOTHING set, the server starts its own local database automatically.

PORT=5000

# ── REQUIRED when deployed (Render/Railway): ──
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/autsera_land
# Local MongoDB:  mongodb://localhost:27017/autsera_land
# MONGO_URI=

# Long random string, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=
MONGO_URI=mongodb+srv://supriyakumari98011_db_user:supriya_ram@cluster0.wfhvqdm.mongodb.net/?appName=Cluster0
JWT_SECRET=supriya_kumari
JWT_EXPIRES_IN=7d

# Websites allowed to call the API (comma-separated). Not needed when the game is opened from the server itself.
CLIENT_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,https://autseraland.netlify.app
